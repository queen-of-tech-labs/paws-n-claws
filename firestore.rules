rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnerByEmail() {
      return isAuthenticated() &&
        resource.data.created_by == request.auth.token.email;
    }

    // profiles
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // All main collections - simplified rules that definitely work for list queries
    match /pets/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /careLogs/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /healthRecords/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /appointments/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /reminders/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /veterinarians/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /forumPosts/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /forumReplies/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /forumCategories/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /petCareGuides/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /petCareCategories/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /rescueSuggestions/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /conversations/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /messages/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /notifications/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    // health_records (snake_case fallback)
    match /health_records/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }

    match /care_logs/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwnerByEmail() || isAdmin());
    }
  }
}
